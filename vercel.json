{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...route].mjs": {
      "includeFiles": "server/migrations/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...route].mjs"
    },
    {
      "source": "/convite/:token",
      "destination": "/piloto/convite.html"
    },
    {
      "source": "/piloto/painel",
      "destination": "/piloto/painel.html"
    },
    {
      "source": "/piloto/como-funciona",
      "destination": "/piloto/como-funciona.html"
    },
    {
      "source": "/piloto/painel/",
      "destination": "/piloto/painel.html"
    },
    {
      "source": "/configurar",
      "destination": "/configurar.html"
    },
    {
      "source": "/portal",
      "destination": "/index.html"
    },
    {
      "source": "/portal/",
      "destination": "/index.html"
    },
    {
      "source": "/conta",
      "destination": "/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/piloto/uso.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
